cat << 'EOF' > patches/ghostty-web@0.3.0.patch
--- a/packages/ghostty-web/src/terminal.ts
+++ b/packages/ghostty-web/src/terminal.ts
@@ -45,6 +45,56 @@
+    private aiEnabled: boolean = true;
+
+    /**
+     * Logger de Decisiones: Registra la interacción Operador-IA.
+     */
+    private logDecision(command: string, approved: boolean) {
+        const logEntry = {
+            timestamp: new Date().toISOString(),
+            command,
+            approved,
+            operator: "human_admin"
+        };
+        console.log("LOG_DECISION:", JSON.stringify(logEntry));
+    }
+
+    public setupHumanControl() {
+        this.terminal.onKey(({ domEvent }) => {
+            if (domEvent.ctrlKey && domEvent.key === 'q') {
+                this.aiEnabled = !this.aiEnabled;
+                const color = this.aiEnabled ? '\x1b[32m' : '\x1b[31m';
+                this.terminal.write(`\r\n${color}[SISTEMA]: IA ${this.aiEnabled ? 'ESCUCHANDO' : 'MUTEO TOTAL'}\x1b[0m\r\n`);
+            }
+        });
+    }
+
+    private async requestOperatorApproval(command: string): Promise<boolean> {
+        if (!this.aiEnabled) return false;
+
+        // ALERTA AUDITIVA: Avisa al humano que se requiere su decisión
+        this.terminal.write('\x07'); 
+        this.terminal.write(`\r\n\x1b[1;33m[IA PROPONE]:\x1b[0m ${command}`);
+        this.terminal.write(`\r\n\x1b[1;36m[VALIDACIÓN]: ¿Ejecutar? (y/n): \x1b[0m`);
+
+        return new Promise((resolve) => {
+            const disposable = this.terminal.onData((data) => {
+                const key = data.toLowerCase();
+                if (key === 'y' || key === '\r') {
+                    this.terminal.write(' \x1b[32m[OK]\x1b[0m\r\n');
+                    this.logDecision(command, true);
+                    disposable.dispose();
+                    resolve(true);
+                } else if (key === 'n' || key === '\x1b') {
+                    this.terminal.write(' \x1b[31m[RECHAZADO]\x1b[0m\r\n');
+                    this.logDecision(command, false);
+                    disposable.dispose();
+                    resolve(false);
+                }
+            });
+        });
+    }
+
     public handleAiResponse(response: string) {
-        this.terminal.sendData(response);
+        this.requestOperatorApproval(response).then((approved) => {
+            if (approved) this.terminal.sendData(response + '\n');
+        });
     }
EOF
